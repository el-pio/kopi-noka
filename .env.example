# ========================================================
# KOPI NOKA - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env.local untuk konfigurasi lokal
# ========================================================

# Identitas Aplikasi
NEXT_PUBLIC_APP_NAME="Kopi Noka"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TIMEZONE="Asia/Makassar"

# Database PostgreSQL (Gunakan URL PostgreSQL untuk production/prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kopi_noka?schema=public"

# Keamanan Sesi & JWT
JWT_SECRET="kopi-noka-super-secret-session-key-replace-in-production-min-32-chars"
SESSION_EXPIRY_HOURS="12"

# Konfigurasi QRIS & Payment Gateway
# Pilihan Mode: "SIMULATION" (Aman untuk dev/testing) atau "PRODUCTION"
QRIS_MODE="SIMULATION"
QRIS_PROVIDER="MIDTRANS" # MIDTRANS, XENDIT, NOBU, STATIS_NMID
QRIS_SERVER_KEY="sandbox_server_key_replace_with_merchant_key"
QRIS_CLIENT_KEY="sandbox_client_key_replace_with_merchant_key"
QRIS_WEBHOOK_SECRET="sandbox_webhook_secret_replace_with_merchant_secret"

# Biaya Transaksi Payment Gateway (MDR - Merchant Discount Rate)
QRIS_FEE_PERCENTAGE="0.7" # Standar BI 0.7% untuk QRIS usaha mikro/reguler
DEBIT_FEE_PERCENTAGE="0.15"

# Batas Diskon Kasir Default (Admin dapat mengubah lewat pengaturan)
DEFAULT_CASHIER_MAX_DISCOUNT_PERCENT="15"

# Konfigurasi Printer Thermal (58mm atau 80mm)
PRINTER_CUSTOMER_NAME="Printer Kasir Utama (Thermal 58mm)"
PRINTER_CUSTOMER_PAPER="58mm"
PRINTER_BARISTA_NAME="Printer Barista Kitchen (Thermal 80mm)"
PRINTER_BARISTA_PAPER="80mm"
